<style>
:root{--black:#080808;--white:#f5f0ea;--gold:#c9a96e;--gold2:#e8d5b0;--dim:#141414;--muted:rgba(245,240,234,.45);--ff-disp:'Cormorant Garamond',serif;--ff-body:'Inter',sans-serif;--ease-out:cubic-bezier(0.16,1,0.3,1)}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{background:var(--black);color:var(--white);font-family:var(--ff-body);font-size:15px;line-height:1.65;overflow-x:hidden;cursor:none}
a{color:inherit;text-decoration:none}
img{display:block;width:100%}

/* Cursor */
#cursor-dot{position:fixed;width:8px;height:8px;background:var(--gold);border-radius:50%;pointer-events:none;z-index:9999;transform:translate(-50%,-50%);transition:width .2s,height .2s,opacity .2s;will-change:transform}
#cursor-ring{position:fixed;width:36px;height:36px;border:1.5px solid rgba(201,169,110,.5);border-radius:50%;pointer-events:none;z-index:9998;transform:translate(-50%,-50%);transition:width .35s var(--ease-out),height .35s var(--ease-out),border-color .3s;will-change:transform}
body.cursor-grow #cursor-dot{width:14px;height:14px}
body.cursor-grow #cursor-ring{width:60px;height:60px;border-color:var(--gold)}
body.cursor-text #cursor-dot{opacity:0}
body.cursor-text #cursor-ring{width:80px;height:80px;border-color:var(--gold)}
#progress-bar{position:fixed;top:0;left:0;height:2px;background:linear-gradient(90deg,var(--gold),var(--gold2));width:0%;z-index:1000}

/* Nav */
nav{position:fixed;top:0;left:0;right:0;z-index:900;display:flex;align-items:center;justify-content:space-between;padding:28px 48px;transition:padding .5s var(--ease-out),background .5s,border-bottom .5s}
nav.scrolled{padding:16px 48px;background:rgba(8,8,8,.94);backdrop-filter:blur(16px);border-bottom:1px solid rgba(201,169,110,.1)}
.nav-logo img{height:40px;width:auto;filter:brightness(0) invert(1)}
.nav-links{display:flex;gap:36px;list-style:none}
.nav-links a{font-size:11px;letter-spacing:.18em;text-transform:uppercase;color:var(--muted);transition:color .3s;position:relative}
.nav-links a::after{content:'';position:absolute;bottom:-4px;left:0;width:0;height:1px;background:var(--gold);transition:width .35s var(--ease-out)}
.nav-links a:hover{color:var(--white)}
.nav-links a:hover::after{width:100%}
.nav-cta{font-size:11px;letter-spacing:.15em;text-transform:uppercase;color:var(--gold);border:1px solid rgba(201,169,110,.4);padding:10px 22px;border-radius:2px;transition:background .3s,color .3s,border-color .3s,transform .2s}
.nav-cta:hover{background:var(--gold);color:var(--black);transform:translateY(-1px)}
.hamburger{display:none;flex-direction:column;gap:5px;cursor:pointer;padding:4px;background:none;border:none}
.hamburger span{display:block;width:24px;height:1.5px;background:var(--white);transition:transform .4s var(--ease-out),opacity .3s,width .3s;transform-origin:left center}
.hamburger.open span:nth-child(1){transform:rotate(45deg) translate(1px,-1px)}
.hamburger.open span:nth-child(2){opacity:0;width:0}
.hamburger.open span:nth-child(3){transform:rotate(-45deg) translate(1px,1px)}
.mobile-menu{position:fixed;inset:0;background:var(--black);z-index:800;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2rem;pointer-events:none;opacity:0;transform:translateY(-20px);transition:opacity .45s var(--ease-out),transform .45s var(--ease-out)}
.mobile-menu.open{opacity:1;transform:translateY(0);pointer-events:all}
.mobile-menu a{font-family:var(--ff-disp);font-size:clamp(2rem,8vw,4rem);font-style:italic;color:var(--muted);text-align:center;display:block;opacity:0;transform:translateY(20px);transition:opacity .4s,transform .4s,color .3s}
.mobile-menu.open a{opacity:1;transform:translateY(0)}
.mobile-menu.open a:nth-child(1){transition-delay:.05s}.mobile-menu.open a:nth-child(2){transition-delay:.1s}.mobile-menu.open a:nth-child(3){transition-delay:.15s}.mobile-menu.open a:nth-child(4){transition-delay:.2s}.mobile-menu.open a:nth-child(5){transition-delay:.25s}.mobile-menu.open a:nth-child(6){transition-delay:.3s}
.mobile-menu a:hover{color:var(--gold)}

/* Masonry Hero */
.masonry-hero{display:grid;grid-template-columns:2fr 1fr 1fr;grid-template-rows:50vh 50vh;height:100vh;min-height:640px;gap:3px;position:relative}
.masonry-hero::after{content:'';position:absolute;inset:0;background:linear-gradient(to bottom,rgba(8,8,8,.55) 0%,transparent 35%,transparent 60%,rgba(8,8,8,.75) 100%);pointer-events:none;z-index:2}
.m-cell{position:relative;overflow:hidden;cursor:pointer}
.m-cell img{width:100%;height:100%;object-fit:cover;transition:transform 1s var(--ease-out)}
.m-cell:hover img{transform:scale(1.06)}
.m-cell:nth-child(1){grid-column:1;grid-row:1/3}
.m-cell:nth-child(2){grid-column:2;grid-row:1}
.m-cell:nth-child(3){grid-column:3;grid-row:1}
.m-cell:nth-child(4){grid-column:2;grid-row:2}
.m-cell:nth-child(5){grid-column:3;grid-row:2}
.m-cell::before{content:'';position:absolute;bottom:0;left:0;width:0;height:2px;background:var(--gold);transition:width .6s var(--ease-out);z-index:4}
.m-cell:hover::before{width:100%}
.masonry-overlay{position:absolute;bottom:0;left:0;right:0;z-index:5;padding:0 64px 72px;display:flex;align-items:flex-end;justify-content:space-between;gap:40px}
.masonry-title{font-family:var(--ff-disp);font-size:clamp(2.8rem,5.5vw,5.5rem);font-weight:300;font-style:italic;line-height:1.05;opacity:0;transform:translateY(30px);animation:fadeUp 1.2s 0.6s var(--ease-out) forwards}
.masonry-title em{font-style:normal;color:var(--gold)}
.masonry-sub{max-width:320px;text-align:right;opacity:0;animation:fadeUp 1s 1s var(--ease-out) forwards}
.masonry-sub p{font-size:13px;color:rgba(245,240,234,.7);line-height:1.8;margin-bottom:20px}
.masonry-eyebrow{position:absolute;top:100px;left:64px;z-index:5;font-size:10px;letter-spacing:.3em;text-transform:uppercase;color:var(--gold);opacity:0;animation:fadeUp .8s .3s var(--ease-out) forwards}
.scroll-hint{position:absolute;bottom:36px;left:50%;transform:translateX(-50%);z-index:5;display:flex;flex-direction:column;align-items:center;gap:10px;color:var(--muted);font-size:9px;letter-spacing:.22em;text-transform:uppercase;opacity:0;animation:fadeUp .8s 1.6s var(--ease-out) forwards}
.scroll-line{width:1px;height:44px;background:linear-gradient(to bottom,var(--gold),transparent);animation:scrollPulse 2.5s ease-in-out infinite}
@keyframes fadeUp{to{opacity:1;transform:translateY(0)}}
@keyframes scrollPulse{0%,100%{opacity:.4;transform:scaleY(.8)}50%{opacity:1;transform:scaleY(1)}}

/* Marquee */
.marquee-section{padding:20px 0;border-top:1px solid rgba(201,169,110,.12);border-bottom:1px solid rgba(201,169,110,.12);overflow:hidden}
.marquee-track{display:flex;width:max-content;animation:marquee 28s linear infinite}
.marquee-section:hover .marquee-track{animation-play-state:paused}
.marquee-item{display:flex;align-items:center;gap:28px;padding:0 28px;white-space:nowrap;font-size:10px;letter-spacing:.25em;text-transform:uppercase;color:var(--muted)}
.marquee-dot{width:4px;height:4px;border-radius:50%;background:var(--gold);flex-shrink:0}
@keyframes marquee{from{transform:translateX(0)}to{transform:translateX(-50%)}}

/* Reveal */
.reveal{opacity:0;transform:translateY(36px);transition:opacity .8s var(--ease-out),transform .8s var(--ease-out)}
.reveal.visible{opacity:1;transform:translateY(0)}
.reveal-delay-1{transition-delay:.1s}.reveal-delay-2{transition-delay:.2s}.reveal-delay-3{transition-delay:.3s}.reveal-delay-4{transition-delay:.4s}.reveal-delay-5{transition-delay:.5s}

/* Section helpers */
.section-label{font-size:10px;letter-spacing:.3em;text-transform:uppercase;color:var(--gold);margin-bottom:16px}
.section-title{font-family:var(--ff-disp);font-size:clamp(2rem,4.5vw,3.6rem);font-weight:300;font-style:italic;line-height:1.1;margin-bottom:56px}
.btn-primary{display:inline-block;padding:15px 34px;background:var(--gold);color:var(--black);font-size:11px;letter-spacing:.18em;text-transform:uppercase;font-weight:600;border-radius:2px;transition:transform .3s var(--ease-out),box-shadow .3s;position:relative;overflow:hidden;border:none;cursor:pointer;font-family:var(--ff-body)}
.btn-primary::before{content:'';position:absolute;inset:0;background:rgba(255,255,255,.15);transform:translateX(-101%);transition:transform .4s var(--ease-out)}
.btn-primary:hover::before{transform:translateX(0)}
.btn-primary:hover{transform:translateY(-2px);box-shadow:0 12px 40px rgba(201,169,110,.3)}
.btn-ghost{display:inline-block;padding:15px 34px;border:1px solid rgba(245,240,234,.22);color:var(--white);font-size:11px;letter-spacing:.18em;text-transform:uppercase;border-radius:2px;transition:border-color .3s,color .3s,transform .3s}
.btn-ghost:hover{border-color:var(--gold);color:var(--gold);transform:translateY(-2px)}

/* Services */
.services-section{padding:120px 64px;background:var(--dim)}
.services-inner{max-width:1320px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:center}
.services-list{list-style:none;display:flex;flex-direction:column}
.service-item{display:flex;align-items:center;gap:20px;padding:22px 0;border-bottom:1px solid rgba(255,255,255,.06);cursor:default;transition:padding-left .3s var(--ease-out)}
.service-item:hover{padding-left:14px}
.service-item:hover .service-num{color:var(--gold)}
.service-num{font-family:var(--ff-disp);font-size:1.8rem;font-style:italic;color:rgba(201,169,110,.22);min-width:48px;transition:color .3s}
.service-name{font-size:13px;letter-spacing:.1em;text-transform:uppercase}
.service-desc{font-size:12px;color:var(--muted);margin-top:3px}
.services-img{position:relative;overflow:hidden;border-radius:2px}
.services-img img{aspect-ratio:3/4;object-fit:cover;transition:transform 1.2s var(--ease-out)}
.services-img:hover img{transform:scale(1.04)}
.services-img::before{content:'Production en Direct';position:absolute;top:20px;left:20px;font-size:9px;letter-spacing:.22em;text-transform:uppercase;color:var(--gold);z-index:2;background:rgba(8,8,8,.65);padding:6px 12px;border-radius:2px;backdrop-filter:blur(4px)}

/* Work — text cards instead of images (no images left) */
.work-section{padding:120px 64px;max-width:1320px;margin:0 auto}
.work-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
.work-card{border:1px solid rgba(255,255,255,.07);border-radius:4px;padding:36px 28px;position:relative;overflow:hidden;transition:border-color .4s,transform .4s var(--ease-out)}
.work-card::before{content:'';position:absolute;top:0;left:0;width:2px;height:0;background:var(--gold);transition:height .5s var(--ease-out)}
.work-card:hover{border-color:rgba(201,169,110,.25);transform:translateY(-6px)}
.work-card:hover::before{height:100%}
.work-card-num{font-family:var(--ff-disp);font-size:3rem;font-style:italic;color:rgba(201,169,110,.1);line-height:1;margin-bottom:16px}
.work-card h3{font-family:var(--ff-disp);font-size:1.3rem;font-style:italic;font-weight:400;margin-bottom:8px}
.work-card p{font-size:12px;color:var(--muted);line-height:1.8}
.work-card .work-tag{display:inline-block;margin-top:16px;font-size:9px;letter-spacing:.2em;text-transform:uppercase;color:var(--gold);border:1px solid rgba(201,169,110,.25);padding:4px 12px;border-radius:100px}

/* Lightbox */
#lightbox{position:fixed;inset:0;z-index:9990;background:rgba(8,8,8,.97);display:flex;align-items:center;justify-content:center;opacity:0;pointer-events:none;transition:opacity .4s;cursor:zoom-out}
#lightbox.open{opacity:1;pointer-events:all}
#lightbox img{max-width:90vw;max-height:90vh;object-fit:contain;border-radius:2px;transform:scale(.92);transition:transform .5s var(--ease-out)}
#lightbox.open img{transform:scale(1)}
#lightbox-close{position:absolute;top:32px;right:40px;font-size:2rem;color:var(--muted);cursor:pointer;transition:color .3s,transform .3s;z-index:2;background:none;border:none;line-height:1}
#lightbox-close:hover{color:var(--gold);transform:rotate(90deg)}
#lightbox-caption{position:absolute;bottom:40px;left:50%;transform:translateX(-50%);text-align:center;font-family:var(--ff-disp);font-style:italic;font-size:1.1rem;color:var(--muted);white-space:nowrap}

/* Packages */
.packages-section{padding:120px 64px;background:var(--dim)}
.packages-inner{max-width:1320px;margin:0 auto}
.packages-header{text-align:center;margin-bottom:80px}
.packages-header .section-title{margin-bottom:0}
.packages-sub{margin-top:14px;font-size:14px;color:var(--muted)}
.billing-toggle{display:flex;align-items:center;justify-content:center;gap:16px;margin-top:28px;font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:var(--muted)}
.toggle-switch{position:relative;width:48px;height:26px;cursor:pointer}
.toggle-switch input{display:none}
.toggle-track{position:absolute;inset:0;background:rgba(255,255,255,.08);border-radius:100px;border:1px solid rgba(255,255,255,.1);transition:background .3s}
.toggle-track::after{content:'';position:absolute;top:3px;left:3px;width:18px;height:18px;border-radius:50%;background:var(--gold);transition:transform .35s var(--ease-out)}
.toggle-switch input:checked+.toggle-track{background:rgba(201,169,110,.12)}
.toggle-switch input:checked+.toggle-track::after{transform:translateX(22px)}
.toggle-label.active{color:var(--white)}
.save-badge{background:rgba(201,169,110,.15);color:var(--gold);font-size:9px;letter-spacing:.1em;padding:3px 9px;border-radius:100px;border:1px solid rgba(201,169,110,.3)}
.packages-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;align-items:start}
.pkg-card{border:1px solid rgba(255,255,255,.07);border-radius:4px;padding:44px 34px;position:relative;transition:border-color .4s,transform .4s var(--ease-out),box-shadow .4s;background:rgba(255,255,255,.02)}
.pkg-card:hover{border-color:rgba(201,169,110,.3);transform:translateY(-6px);box-shadow:0 24px 60px rgba(0,0,0,.5)}
.pkg-card.featured{border-color:rgba(201,169,110,.35);background:rgba(201,169,110,.04);transform:translateY(-12px);box-shadow:0 32px 80px rgba(0,0,0,.6)}
.pkg-card.featured:hover{transform:translateY(-18px)}
.pkg-badge{position:absolute;top:-13px;left:50%;transform:translateX(-50%);background:var(--gold);color:var(--black);font-size:9px;letter-spacing:.18em;text-transform:uppercase;font-weight:700;padding:4px 18px;border-radius:100px;white-space:nowrap}
.pkg-name{font-family:var(--ff-disp);font-size:1.1rem;font-style:italic;color:var(--gold);margin-bottom:8px;text-transform:uppercase;letter-spacing:.08em}
.pkg-price{font-family:var(--ff-disp);font-size:3rem;font-weight:300;line-height:1;margin-bottom:4px}
.pkg-price sup{font-size:1.2rem;vertical-align:super}
.pkg-price span.period{font-size:.95rem;color:var(--muted);font-family:var(--ff-body)}
.pkg-desc{font-size:12px;color:var(--muted);margin-bottom:28px;line-height:1.7;margin-top:8px}
.pkg-divider{height:1px;background:rgba(255,255,255,.07);margin-bottom:24px}
.pkg-features{list-style:none;display:flex;flex-direction:column;gap:13px;margin-bottom:32px}
.pkg-features li{display:flex;align-items:flex-start;gap:12px;font-size:13px;color:var(--muted)}
.pkg-features li::before{content:'✦';color:var(--gold);font-size:8px;margin-top:5px;flex-shrink:0}
.pkg-btn{display:block;text-align:center;padding:14px;border:1px solid rgba(201,169,110,.4);border-radius:2px;font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--gold);transition:background .3s,color .3s,border-color .3s,transform .2s}
.pkg-btn:hover{background:var(--gold);color:var(--black);border-color:var(--gold);transform:translateY(-1px)}
.pkg-card.featured .pkg-btn{background:var(--gold);color:var(--black);border-color:var(--gold)}
.pkg-card.featured .pkg-btn:hover{background:var(--gold2);border-color:var(--gold2)}

/* About — no image, full width text + stats */
.about-section{padding:120px 64px;max-width:1320px;margin:0 auto}
.about-inner{display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:start}
.about-text p{color:var(--muted);line-height:1.9;font-size:14px;margin-bottom:20px}
.about-stats{display:grid;grid-template-columns:repeat(2,1fr);gap:20px;margin-top:44px}
.stat-box{padding:22px;border:1px solid rgba(255,255,255,.07);border-radius:2px;transition:border-color .3s,transform .3s}
.stat-box:hover{border-color:rgba(201,169,110,.3);transform:translateY(-3px)}
.stat-num{font-family:var(--ff-disp);font-size:2.4rem;font-weight:300;color:var(--gold);line-height:1;margin-bottom:5px}
.stat-label{font-size:10px;letter-spacing:.16em;text-transform:uppercase;color:var(--muted)}
.about-quote{border-left:2px solid var(--gold);padding-left:28px;margin-top:48px}
.about-quote blockquote{font-family:var(--ff-disp);font-size:1.4rem;font-style:italic;line-height:1.5;color:var(--white);margin-bottom:12px}
.about-quote cite{font-size:11px;letter-spacing:.15em;text-transform:uppercase;color:var(--muted)}

/* SEO Cards */
.seo-section{padding:100px 64px;background:var(--black)}
.seo-inner{max-width:1320px;margin:0 auto}
.seo-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:40px;margin-top:56px}
.seo-card{padding:32px;border:1px solid rgba(255,255,255,.06);border-radius:2px;transition:border-color .4s,transform .3s}
.seo-card:hover{border-color:rgba(201,169,110,.2);transform:translateY(-4px)}
.seo-card h3{font-family:var(--ff-disp);font-size:1.3rem;font-style:italic;color:var(--white);margin-bottom:12px}
.seo-card p{font-size:13px;color:var(--muted);line-height:1.8}
.seo-icon{font-size:1.5rem;color:var(--gold);margin-bottom:16px}

/* Instagram — CTA only, no images */
.ig-section{padding:100px 64px;background:var(--dim)}
.ig-inner{max-width:900px;margin:0 auto;text-align:center}
.ig-handle-display{font-family:var(--ff-disp);font-size:clamp(3rem,7vw,6rem);font-style:italic;font-weight:300;color:var(--white);margin:32px 0;line-height:1;transition:color .4s}
.ig-handle-display em{color:var(--gold)}
.ig-handle-display:hover{color:var(--gold)}
.ig-sub{font-size:13px;color:var(--muted);margin-bottom:44px;line-height:1.8}


/* Contact */
.contact-section{padding:120px 64px;background:var(--dim)}
.contact-inner{max-width:900px;margin:0 auto;text-align:center}
.contact-inner .section-title{margin-bottom:16px}
.contact-inner>p{color:var(--muted);font-size:14px;margin-bottom:52px}
.contact-form{text-align:left}
.form-row{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:20px}
.form-group{position:relative}
.form-group label{position:absolute;top:18px;left:20px;font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);transition:top .25s,font-size .25s,color .25s;pointer-events:none}
.form-group input,.form-group select,.form-group textarea{width:100%;padding:28px 20px 12px;background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.08);color:var(--white);font-family:var(--ff-body);font-size:14px;border-radius:2px;outline:none;transition:border-color .3s,background .3s;-webkit-appearance:none}
.form-group select{cursor:pointer;padding:20px 20px 12px;background:rgba(255,255,255,.04)}
.form-group select option{background:#111}
.form-group input:focus,.form-group select:focus,.form-group textarea:focus{border-color:rgba(201,169,110,.5);background:rgba(255,255,255,.06)}
.form-group input:focus+label,.form-group input:not(:placeholder-shown)+label,.form-group select:focus+label,.form-group select.has-value+label,.form-group textarea:focus+label,.form-group textarea:not(:placeholder-shown)+label{top:8px;font-size:9px;color:var(--gold)}
.form-group textarea{resize:vertical;min-height:130px}
.form-full{margin-bottom:20px}
.form-submit{display:flex;align-items:center;justify-content:center;margin-top:32px}
.form-submit .btn-primary{min-width:240px}
.form-status{font-size:13px;color:var(--gold);text-align:center;min-height:24px;margin-top:14px}

/* Footer */
footer{padding:52px 64px 36px;border-top:1px solid rgba(255,255,255,.06);display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:24px}
footer .logo-footer img{height:34px;width:auto;filter:brightness(0) invert(1);opacity:.45}
footer p{font-size:11px;color:rgba(245,240,234,.28);letter-spacing:.08em}
.footer-links{display:flex;gap:28px}
.footer-links a{font-size:10px;letter-spacing:.16em;text-transform:uppercase;color:rgba(245,240,234,.28);transition:color .3s}
.footer-links a:hover{color:var(--gold)}

/* Responsive */
@media(max-width:1024px){
  .masonry-hero{grid-template-columns:1fr 1fr;grid-template-rows:40vh 30vh 30vh}
  .m-cell:nth-child(1){grid-column:1/3;grid-row:1}
  .m-cell:nth-child(2){grid-column:1;grid-row:2}
  .m-cell:nth-child(3){grid-column:2;grid-row:2}
  .m-cell:nth-child(4){grid-column:1;grid-row:3}
  .m-cell:nth-child(5){grid-column:2;grid-row:3}
  .masonry-overlay{padding:0 32px 48px}
  .services-inner{grid-template-columns:1fr;gap:48px}
  .packages-grid{grid-template-columns:1fr}
  .pkg-card.featured{transform:none}
  .about-inner{grid-template-columns:1fr}
  .seo-grid{grid-template-columns:1fr 1fr}
  .work-grid{grid-template-columns:1fr 1fr}
}
@media(max-width:768px){
  nav{padding:22px 24px}nav.scrolled{padding:14px 24px}
  .nav-links,.nav-cta{display:none}
  .hamburger{display:flex}
  .masonry-hero{grid-template-columns:1fr;grid-template-rows:35vh 25vh 25vh 25vh 25vh;height:auto}
  .m-cell:nth-child(1){grid-column:1;grid-row:1}
  .m-cell:nth-child(2){grid-column:1;grid-row:2}
  .m-cell:nth-child(3){grid-column:1;grid-row:3}
  .m-cell:nth-child(4){grid-column:1;grid-row:4}
  .m-cell:nth-child(5){grid-column:1;grid-row:5}
  .masonry-overlay{padding:0 24px 40px;flex-direction:column;align-items:flex-start}
  .masonry-sub{text-align:left}
  .masonry-eyebrow{top:80px;left:24px}
  .work-section,.ig-section,.about-section,.seo-section,.contact-section,.packages-section,.services-section{padding:80px 24px}
  footer{flex-direction:column;text-align:center;padding:36px 24px}
  .form-row{grid-template-columns:1fr}
  .seo-grid{grid-template-columns:1fr}
  .work-grid{grid-template-columns:1fr}
  body{cursor:auto}
  #cursor-dot,#cursor-ring{display:none}
}
